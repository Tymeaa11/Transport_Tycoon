<Window x:Class="VolcanicTransport_WPF.View.MainGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:VolcanicTransport_WPF.View"
        xmlns:vm="clr-namespace:VolcanicTransport_WPF.ViewModel" 
        d:DataContext="{d:DesignInstance Type=vm:GameViewModel}"
        mc:Ignorable="d"
        Title="VolcanicTransport" Height="450" Width="800"
        x:Name="RootWindow"
        >

    <Window.InputBindings>
        <KeyBinding Key="W" Command="{Binding Camera.MoveUp}" />
        <KeyBinding Key="S" Command="{Binding Camera.MoveDown}" />
        <KeyBinding Key="A" Command="{Binding Camera.MoveLeft}" />
        <KeyBinding Key="D" Command="{Binding Camera.MoveRight}" />
    </Window.InputBindings>

    <Window.Resources>
        <view:ChunkToPixelConverter x:Key="ChunkToPixelConverter" />
        <view:FieldToPixelConverter x:Key="FieldToPixelConverter" />
        <view:BuildabilityToColorConverter x:Key="BuildabilityToColorConverter" />
    </Window.Resources>

    <Grid x:Name="ViewPort" ClipToBounds="True">


        <ItemsControl ItemsSource="{Binding LoadedChunks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="WorldContainer" 
                            SnapsToDevicePixels="true"
                            RenderOptions.EdgeMode="Aliased">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="{Binding DataContext.Camera.ProjectionMatrix,
                                             Source={x:Reference RootWindow}}" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <view:VisualChunk />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Path=Coordinate.X, Converter={StaticResource ChunkToPixelConverter}}" />
                    <Setter Property="Canvas.Top" Value="{Binding Path=Coordinate.Y, Converter={StaticResource ChunkToPixelConverter}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>


        <Canvas IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <MatrixTransform Matrix="{Binding Camera.ProjectionMatrix}" />
            </Canvas.RenderTransform>

            <Rectangle Width="{Binding TileSize}" Height="{Binding TileSize}" StrokeThickness="2">
                <Rectangle.Fill>
                    <Binding Path="IsHoveredFieldBuildable" Converter="{StaticResource BuildabilityToColorConverter}" />
                </Rectangle.Fill>
                <Rectangle.Stroke>
                    <Binding Path="IsHoveredFieldBuildable" Converter="{StaticResource BuildabilityToColorConverter}" />
                </Rectangle.Stroke>

                <Rectangle.RenderTransform>
                    <TranslateTransform
                    X="{Binding HoveredCoordinate.X, Converter={StaticResource FieldToPixelConverter}}"
                    Y="{Binding HoveredCoordinate.Y, Converter={StaticResource FieldToPixelConverter}}" />
                </Rectangle.RenderTransform>

                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HoveredCoordinate}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Canvas>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#CC222222" CornerRadius="8" Padding="10">
            <StackPanel Orientation="Horizontal">

                <ToggleButton Content="Út lerakása" 
              Command="{Binding SetRoadModeCommand}" 
              IsChecked="{Binding IsRoadModeActive, Mode=OneWay}"
              Padding="15,8" Margin="5" 
              Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#FF444444"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="2"/>

                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="ForestGreen"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="LightGreen"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

            </StackPanel>
        </Border>


    </Grid>
</Window>
