<Window x:Class="VolcanicTransport_WPF.View.MainGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:VolcanicTransport_WPF.View"
        xmlns:vm="clr-namespace:VolcanicTransport_WPF.ViewModel" 
        d:DataContext="{d:DesignInstance Type=vm:GameViewModel}"
        mc:Ignorable="d"
        Title="VolcanicTransport" Height="450" Width="800"
        x:Name="RootWindow"
        >

    <Window.InputBindings>
        <KeyBinding Key="W" Command="{Binding Camera.MoveUp}" />
        <KeyBinding Key="S" Command="{Binding Camera.MoveDown}" />
        <KeyBinding Key="A" Command="{Binding Camera.MoveLeft}" />
        <KeyBinding Key="D" Command="{Binding Camera.MoveRight}" />
        <KeyBinding Key="G" Command="{Binding ReGenerateWithRandomSeed}" />
    </Window.InputBindings>

    <Window.Resources>
        <view:ChunkToPixelConverter x:Key="ChunkToPixelConverter" />
        <view:FieldToPixelConverter x:Key="FieldToPixelConverter" />
        <view:BuildabilityToColorConverter x:Key="BuildabilityToColorConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid x:Name="ViewPort" ClipToBounds="True">
        <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,40,0,0" IsHitTestVisible="False" Panel.ZIndex="1000">
            <Border Background="Gray" BorderBrush="Black" BorderThickness="1.5" 
                CornerRadius="5" Padding="10"
                Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding InspectorText}" Foreground="White" 
                       FontFamily="Consolas" FontSize="13"/>
            </Border>
        </Canvas>

        <ItemsControl ItemsSource="{Binding LoadedChunks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="WorldContainer" 
                            SnapsToDevicePixels="true"
                            RenderOptions.EdgeMode="Aliased">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="{Binding DataContext.Camera.ProjectionMatrix,
                                             Source={x:Reference RootWindow}}" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <view:VisualChunk />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Path=Coordinate.X, Converter={StaticResource ChunkToPixelConverter}}" />
                    <Setter Property="Canvas.Top" Value="{Binding Path=Coordinate.Y, Converter={StaticResource ChunkToPixelConverter}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding VehicleViewModels}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="{Binding DataContext.Camera.ProjectionMatrix,
                                                        Source={x:Reference RootWindow}}" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding VisualX}" />
                    <Setter Property="Canvas.Top" Value="{Binding VisualY}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="24" Height="12" Fill="Red" Stroke="White" StrokeThickness="1" 
           RadiusX="2" RadiusY="2">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform X="-12" Y="-6" />
                                <RotateTransform Angle="{Binding VisualAngle}" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                        <Rectangle.ToolTip>
                            <TextBlock Text="{Binding Name}" />
                        </Rectangle.ToolTip>
                    </Rectangle>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <Canvas IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <MatrixTransform Matrix="{Binding Camera.ProjectionMatrix}" />
            </Canvas.RenderTransform>

            <Rectangle Width="{Binding TileSize}" Height="{Binding TileSize}" StrokeThickness="2">
                <Rectangle.Fill>
                    <Binding Path="IsHoveredFieldBuildable" Converter="{StaticResource BuildabilityToColorConverter}" />
                </Rectangle.Fill>
                <Rectangle.Stroke>
                    <Binding Path="IsHoveredFieldBuildable" Converter="{StaticResource BuildabilityToColorConverter}" />
                </Rectangle.Stroke>

                <Rectangle.RenderTransform>
                    <TranslateTransform
                    X="{Binding HoveredCoordinate.X, Converter={StaticResource FieldToPixelConverter}}"
                    Y="{Binding HoveredCoordinate.Y, Converter={StaticResource FieldToPixelConverter}}" />
                </Rectangle.RenderTransform>

                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HoveredCoordinate}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Canvas>

        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
        Width="180" Margin="0,0,20,0" Padding="15"
        Background="#E6FFFFFF" BorderBrush="#FF808080" BorderThickness="1" CornerRadius="5"
        Visibility="{Binding IsVehiclePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Járművek" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding VehicleViewModels}" 
              SelectedItem="{Binding SelectedVehicle}" 
              DisplayMemberPath="GetName" 
              Margin="0,0,0,10" Padding="5"/>

                <Separator Margin="0,0,0,10"/>

                <StackPanel TextBlock.FontSize="13">
                    <TextBlock Text="{Binding SelectedVehicle.StateDisplay, StringFormat='Állapot: {0}'}" Foreground="DarkBlue" Margin="0,3"/>
                    <TextBlock Text="{Binding SelectedVehicle.Type, StringFormat='Típus: {0}'}" Margin="0,3"/>
                    <TextBlock Text="{Binding SelectedVehicle.SpeedDisplay, StringFormat='Sebesség: {0}'}" Margin="0,3"/>
                    <TextBlock Text="{Binding SelectedVehicle.GetCapacity, StringFormat='Kapacitás: {0}'}" Margin="0,3"/>
                </StackPanel>

                <TextBlock Text="Menetrend:" FontWeight="Bold" Margin="0,15,0,5"/>
                <ListBox ItemsSource="{Binding SelectedVehicle.ScheduleList}" 
             Background="#F0F0F0" BorderBrush="#CCCCCC"
             MinHeight="60" MaxHeight="100" Margin="0,0,0,10"
             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <UniformGrid Columns="1" Margin="0,5,0,0">
                    <Button Content="Új menetrend" 
                Command="{Binding ClearRouteCommand}" 
                Margin="0,2" Padding="5"/>

                    <Button Content="Állomás hozzáadása" 
                Command="{Binding AddStopCommand}" 
                Margin="0,2" Padding="5"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="MenuButtonStyle" TargetType="ButtonBase">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="2,4,2,4"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="Background" Value="#FFAFAFAF"/>
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MenuButtonStyle}"/>
                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}"/>
                </StackPanel.Resources>

                <ToggleButton Content="Buy vehicle" 
                      Command="{Binding BuyVehicleCommand}" 
                      IsChecked="{Binding IsBuildModeBuyVehicle, Mode=OneWay}" />
                <ToggleButton Content="Road" 
                      Command="{Binding SetBuildModeRoadCommand}" 
                      IsChecked="{Binding IsBuildModeRoad, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Station" 
                      Command="{Binding SetBuildModeStationCommand}" 
                      IsChecked="{Binding IsBuildModeStation, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Bridge" 
                      Command="{Binding SetBuildModeBridgeCommand}" 
                      IsChecked="{Binding IsBuildModeBridge, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Lower" 
                      Command="{Binding SetBuildModeLowerCommand}" 
                      IsChecked="{Binding IsBuildModeLower, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Heighten" 
                      Command="{Binding SetBuildModeHeightenCommand}" 
                      IsChecked="{Binding IsBuildModeHeighten, Mode=OneWay}">
                </ToggleButton>
            </StackPanel>
        </Border>


        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,0" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <StackPanel Orientation="Horizontal" >
                <StackPanel.Resources>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Width" Value="32" />
                        <Setter Property="FontStretch" Value="Expanded"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="2,4,2,4"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Background" Value="#FFAFAFAF"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>

                </StackPanel.Resources>

                <ToggleButton Content="||" 
                              Command="{Binding SetTimescale0Command}" 
                              IsChecked="{Binding IsTimescale0, Mode=OneWay}">
                </ToggleButton>
                <ToggleButton Content="1x" 
                              Command="{Binding SetTimescale1Command}" 
                              IsChecked="{Binding IsTimescale1, Mode=OneWay}">
                </ToggleButton>
                <ToggleButton Content="2x" 
                              Command="{Binding SetTimescale2Command}" 
                              IsChecked="{Binding IsTimescale2, Mode=OneWay}">
                </ToggleButton>
                <ToggleButton Content="4x" 
                              Command="{Binding SetTimescale4Command}" 
                              IsChecked="{Binding IsTimescale4, Mode=OneWay}">
                </ToggleButton>

            </StackPanel>
        </Border>

        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <TextBlock Text ="{Binding CurrentMoney}" FontSize="16" Margin="4">
            </TextBlock>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,0" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <TextBlock Text ="{Binding ToolTipText}" FontSize="16" Margin="4">
            </TextBlock>
        </Border>

        <Grid x:Name="PauseOverlay" Visibility="{Binding IsPausedView, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="Black" Opacity="0.5"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Paused" 
                   FontSize="48" FontFamily="Impact" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button Content="Resume Game" Command="{Binding ResumeCommand}"
                Width="200" Padding="10" Margin="0,0,0,15" FontSize="18"/>

                <Button Content="Save Game"
                Width="200" Padding="10" Margin="0,0,0,15" FontSize="18"/>

                <Button Content="Load Game"
                Width="200" Padding="10" Margin="0,0,0,15" FontSize="18"/>

                <Button Content="Quit to Menu" Command="{Binding QuitToMainMenuCommand}"
                Width="200" Padding="10" FontSize="18"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
