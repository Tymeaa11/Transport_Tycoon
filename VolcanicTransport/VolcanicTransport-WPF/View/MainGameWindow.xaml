<Window x:Class="VolcanicTransport_WPF.View.MainGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:VolcanicTransport_WPF.View"
        xmlns:vm="clr-namespace:VolcanicTransport_WPF.ViewModel" 
        d:DataContext="{d:DesignInstance Type=vm:GameViewModel}"
        mc:Ignorable="d"
        Title="VolcanicTransport" Height="450" Width="800"
        x:Name="RootWindow"
        >

    <Window.InputBindings>
        <KeyBinding Key="G" Command="{Binding ReGenerateWithRandomSeed}" />
    </Window.InputBindings>

    <Window.Resources>
        <view:ChunkToPixelConverter x:Key="ChunkToPixelConverter" />
        <view:MiniChunkToPixelConverter x:Key="MiniChunkToPixelConverter" />
        <view:FieldToPixelConverter x:Key="FieldToPixelConverter" />
        <view:BuildabilityToColorConverter x:Key="BuildabilityToColorConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid x:Name="ViewPort" ClipToBounds="True">
        <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,40,0,0" IsHitTestVisible="False" Panel.ZIndex="1000">
            <Border Padding="15" Background="#E6FFFFFF" BorderBrush="#FF808080" BorderThickness="1" CornerRadius="5"
                Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding InspectorText}" Foreground="Black"/>
            </Border>
        </Canvas>

        <ItemsControl ItemsSource="{Binding LoadedChunks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="WorldContainer" 
                            SnapsToDevicePixels="true"
                            RenderOptions.EdgeMode="Aliased">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="{Binding DataContext.Camera.ProjectionMatrix,
                                             Source={x:Reference RootWindow}}" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <view:VisualChunk />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Path=Chunk.Coordinate.X, Converter={StaticResource ChunkToPixelConverter}}" />
                    <Setter Property="Canvas.Top" Value="{Binding Path=Chunk.Coordinate.Y, Converter={StaticResource ChunkToPixelConverter}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding VehicleViewModels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="{Binding DataContext.Camera.ProjectionMatrix,
                                                        Source={x:Reference RootWindow}}" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding VisualX}" />
                    <Setter Property="Canvas.Top" Value="{Binding VisualY}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- magic suspected here -->
                    <Rectangle Width="18" Height="9" Fill="Red" Stroke="White" StrokeThickness="1" 
           RadiusX="2" RadiusY="2">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform X="-12" Y="-6" />
                                <RotateTransform Angle="{Binding VisualAngle}" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                        <Rectangle.ToolTip>
                            <TextBlock Text="{Binding Name}" />
                        </Rectangle.ToolTip>
                    </Rectangle>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <MatrixTransform Matrix="{Binding Camera.ProjectionMatrix}" />
            </Canvas.RenderTransform>

            <Rectangle Width="{Binding TileSize}" Height="{Binding TileSize}" StrokeThickness="2">
                <Rectangle.Fill>
                    <Binding Path="IsHoveredFieldBuildable" Converter="{StaticResource BuildabilityToColorConverter}" />
                </Rectangle.Fill>
                <Rectangle.Stroke>
                    <Binding Path="IsHoveredFieldBuildable" Converter="{StaticResource BuildabilityToColorConverter}" />
                </Rectangle.Stroke>

                <Rectangle.RenderTransform>
                    <TranslateTransform
                    X="{Binding HoveredCoordinate.X, Converter={StaticResource FieldToPixelConverter}}"
                    Y="{Binding HoveredCoordinate.Y, Converter={StaticResource FieldToPixelConverter}}" />
                </Rectangle.RenderTransform>

                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HoveredCoordinate}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Canvas>


        <!--minimap-->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" 
                Width="{Binding MinimapBorderSize}" Height="{Binding MinimapBorderSize}" Margin="8" Padding="0"
                BorderBrush="Black" Background="White" BorderThickness="10" CornerRadius="5" Panel.ZIndex="100">

            <Canvas>
                <ItemsControl ItemsSource="{Binding LoadedChunks}"  >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas SnapsToDevicePixels="true" RenderOptions.EdgeMode="Aliased">
                            </Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <view:MiniVisualChunk />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Path=Chunk.Coordinate.X, Converter={StaticResource MiniChunkToPixelConverter}}" />
                            <Setter Property="Canvas.Top" Value="{Binding Path=Chunk.Coordinate.Y, Converter={StaticResource MiniChunkToPixelConverter}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <Rectangle Canvas.Top="{Binding MinimapSelector.Top}" Canvas.Left="{Binding MinimapSelector.Left}" Width="{Binding MinimapSelector.Width}" Height="{Binding MinimapSelector.Height}"
                           Stroke="Lime" StrokeThickness="1" Fill="#AAAAAAAA">
                </Rectangle>
                <Rectangle Canvas.Top="0" Canvas.Left="0" Width="{Binding MinimapSize}" Height="{Binding MinimapSize}" Cursor="Cross" x:Name="MinimapBounds" Fill="#00000000"></Rectangle>
                <!--for finding binding box of minimap-->
            </Canvas>
        </Border>


        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="200" Margin="0,0,20,40" Padding="15" Background="#E6FFFFFF" BorderBrush="#FF808080" BorderThickness="1" CornerRadius="5" Visibility="{Binding IsVehiclePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Vehicles" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding VehicleViewModels}" SelectedItem="{Binding SelectedVehicle}" DisplayMemberPath="GetName" Margin="0,0,0,10" Padding="5"/>

                <Separator Margin="0,0,0,10"/>

                <StackPanel TextBlock.FontSize="13">
                    <TextBlock Text="{Binding SelectedVehicle.StateDisplay, StringFormat='State: {0}'}" Foreground="DarkBlue" Margin="0,3"/>
                    <TextBlock Text="{Binding SelectedVehicle.Type, StringFormat='Type: {0}'}" Margin="0,3"/>
                    <TextBlock Text="{Binding SelectedVehicle.SpeedDisplay, StringFormat='Speed: {0}'}" Margin="0,3"/>
                    <TextBlock Text="{Binding SelectedVehicle.GetCurrentCapacity, StringFormat='Capacity: {0}'}" Margin="0,3"/>
                </StackPanel>

                <TextBlock Text="Current Route:" FontWeight="Bold" Margin="0,15,0,5"/>
                <ListBox ItemsSource="{Binding SelectedVehicle.ScheduleList}" Background="#F0F0F0" BorderBrush="#CCCCCC" MinHeight="60" MaxHeight="100" Margin="0,0,0,10" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <Border Background="#D0D0D0" CornerRadius="5" Padding="10" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Assign New Timetable:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding SavedRoutes}" SelectedItem="{Binding SelectedSavedRoute}" DisplayMemberPath="Name" Margin="0,0,0,5" Padding="4"/>
                        <Button Content="Assign Route" Command="{Binding AssignSavedRouteCommand}" Padding="5" FontWeight="SemiBold" Background="#AEEA00"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="220" Margin="20,0,0,80" Padding="15" Background="#E6FFFFFF" BorderBrush="#FF808080" BorderThickness="1" CornerRadius="5" Visibility="{Binding IsTimetablePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Timetables (Lines)" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Create New Line:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewRouteName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Create" Command="{Binding CreateGlobalRouteCommand}" Padding="10,4"/>
                </Grid>

                <Separator Margin="0,0,0,10"/>

                <TextBlock Text="Select Line to Edit:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding SavedRoutes}" SelectedItem="{Binding SelectedSavedRoute}" DisplayMemberPath="Name" Margin="0,0,0,10" Padding="4"/>

                <ToggleButton Content="Add Stops (Click on Map)" Command="{Binding EditGlobalRouteCommand}" IsChecked="{Binding IsBuildModeEditGlobalRoute, Mode=OneWay}" Margin="0,0,0,10" Padding="5" Background="#FFD54F"/>

                <TextBlock Text="Stops in selected line:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding SelectedSavedRoute.Stops}" DisplayMemberPath="Coordinate" Background="#F0F0F0" BorderBrush="#CCCCCC" MinHeight="100" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>


        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="MenuButtonStyle" TargetType="ButtonBase">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="2,4,2,4"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="Background" Value="#FFAFAFAF"/>
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MenuButtonStyle}"/>
                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}"/>
                </StackPanel.Resources>

                <Button Content="Buy vehicle" 
                      Command="{Binding BuyVehicleCommand}" />
                <ToggleButton Content="Road" 
                      Command="{Binding SetBuildModeRoadCommand}" 
                      IsChecked="{Binding IsBuildModeRoad, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Station" 
                      Command="{Binding SetBuildModeStationCommand}" 
                      IsChecked="{Binding IsBuildModeStation, Mode=OneWay}">
                </ToggleButton>

                <Grid>
                    <ToggleButton x:Name="BridgeButton" Content="Bridge" 
                          Command="{Binding SetBuildModeBridgeCommand}" 
                          IsChecked="{Binding IsBuildModeBridge, Mode=OneWay}" />

                    <Popup IsOpen="{Binding IsBridgeMenuOpen}" PlacementTarget="{Binding ElementName=BridgeButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#E6FFFFFF" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Text="Hídtípus:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableBridges}" 
                                          SelectedItem="{Binding SelectedBridgeType}" 
                                          DisplayMemberPath="Name" 
                                          Width="220" Padding="4"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <ToggleButton Content="Lower" 
                      Command="{Binding SetBuildModeLowerCommand}" 
                      IsChecked="{Binding IsBuildModeLower, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Heighten" 
                      Command="{Binding SetBuildModeHeightenCommand}" 
                      IsChecked="{Binding IsBuildModeHeighten, Mode=OneWay}">
                </ToggleButton>

                <ToggleButton Content="Vehicles" 
                      Command="{Binding ToggleVehiclePanelCommand}" 
                      IsChecked="{Binding IsVehiclePanelVisible, Mode=OneWay}" />

                <ToggleButton Content="Timetables" 
                      Command="{Binding ToggleTimetablePanelCommand}" 
                      IsChecked="{Binding IsTimetablePanelVisible, Mode=OneWay}" />
            </StackPanel>
        </Border>


        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,0" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <StackPanel Orientation="Horizontal" >
                <StackPanel.Resources>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Width" Value="32" />
                        <Setter Property="FontStretch" Value="Expanded"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="2,4,2,4"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Background" Value="#FFAFAFAF"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>

                </StackPanel.Resources>

                <ToggleButton Content="||" 
                              Command="{Binding SetTimeScale0Command}" 
                              IsChecked="{Binding IsTimeScale0, Mode=OneWay}">
                </ToggleButton>
                <ToggleButton Content="1x" 
                              Command="{Binding SetTimeScale1Command}" 
                              IsChecked="{Binding IsTimeScale1, Mode=OneWay}">
                </ToggleButton>
                <ToggleButton Content="2x" 
                              Command="{Binding SetTimeScale2Command}" 
                              IsChecked="{Binding IsTimeScale2, Mode=OneWay}">
                </ToggleButton>
                <ToggleButton Content="4x" 
                              Command="{Binding SetTimeScale4Command}" 
                              IsChecked="{Binding IsTimeScale4, Mode=OneWay}">
                </ToggleButton>

            </StackPanel>
        </Border>

        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <TextBlock Text ="{Binding CurrentMoney}" FontSize="16" Margin="4">
            </TextBlock>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,0" Background="#CCAFAFAF" CornerRadius="0" Padding="0">
            <TextBlock Text ="{Binding ToolTipText}" FontSize="16" Margin="4">
            </TextBlock>
        </Border>

        <Grid x:Name="PauseOverlay" Visibility="{Binding IsPausedView, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="Black" Opacity="0.5"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Paused" 
                   FontSize="48" FontFamily="Impact" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button Content="Resume Game" Command="{Binding ResumeCommand}"
                Width="200" Padding="10" Margin="0,0,0,15" FontSize="18"/>

                <Button Content="Save Game" Command="{Binding SaveGameCommand}"
                Width="200" Padding="10" Margin="0,0,0,15" FontSize="18"/>

                <Button Content="Load Game" Command="{Binding LoadGameCommand}"
                Width="200" Padding="10" Margin="0,0,0,15" FontSize="18"/>

                <Button Content="Quit to Menu" Command="{Binding QuitToMainMenuCommand}"
                Width="200" Padding="10" FontSize="18"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>