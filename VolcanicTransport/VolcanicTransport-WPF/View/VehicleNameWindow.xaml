<Window x:Class="VolcanicTransport_WPF.View.VehicleNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VolcanicTransport_WPF.View"
        mc:Ignorable="d"
        Title="VehicleNameWindow" Height="450" Width="800">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Add meg az új jármű nevét:" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBox x:Name="NameTextBox" Height="25" Padding="2"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Mégse" Width="70" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button Content="Vásárlás" Width="70" Click="OkButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
