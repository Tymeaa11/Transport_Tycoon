' ==========================================
' INCREMENTAL TOPOLOGICAL GRAPH
' ==========================================
class RoadNetwork {

nodes : List<GraphNode>
edges : List<GraphEdge>

CalculatePath(start : Station, end : Station) : List<GraphEdge>
OnRoadBuilt(f : Field) : void
OnRoadRemoved(f : Field) : void
SplitEdge(edgeToSplit : GraphEdge, crossRoad : Field) : void
MergeEdges(nodeToRemove : GraphNode) : void
}

class GraphNode {

field : Field
nodeType : string
}

class GraphEdge {
totalCost : double
pathFields : List<RoadField>
}

' ==========================================
' LOGISTICS & ENTITIES
' ==========================================

class Route {
-stops : List<Station>
-roadsToNextStation : List<RoadField>
-isLoop : bool

+GetNextStop(current : Staton) : Station
+GetRoadsToNextStation (curr : Station, next : Station) : List<RoadField>
}

RoadField --* Route
RoadNetwork --- Route

abstract class Vehicle {
-name : string
-route : Route
-currentSpeed : double
-maxSpeed :double
-capacity : int
-currentEdge : GraphEdge
-currentCoordinate : Coordinate
-maintenanceCost : int
-price : int

-Move(deltaTime : float) : void
-RecalculatePath() : void
+Load() : bool
+UnLoad() : bool
}

Route "1" --* Vehicle

